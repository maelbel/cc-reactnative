# Copier ce fichier en ".env" puis renseigner les valeurs.
# ".env" est ignoré par git ; ".env.example" (sans valeurs réelles) est versionné.
# Expo n'expose au code que les variables préfixées par EXPO_PUBLIC_.
# Après modification : relancer avec `npx expo start -c`.

EXPO_PUBLIC_TRAINING_API_BASE_URL=https://dawan.org/public/training
EXPO_PUBLIC_QUOTE_RECIPIENT_EMAIL=commercial@example.fr
EXPO_PUBLIC_EMAILJS_SERVICE_ID=
EXPO_PUBLIC_EMAILJS_TEMPLATE_ID=
EXPO_PUBLIC_EMAILJS_PUBLIC_KEY=
EXPO_PUBLIC_HTTP_TIMEOUT_MS=10000
